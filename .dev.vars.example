# Local development only. First follow docs/WEB.md#register-a-discord-application
# to get the client ID, client secret, server ID, and role ID from Discord.
# Register the local callback below on that development application.
# Copy this file to .dev.vars and fill in the Discord values you collected.
# Use numeric Discord IDs. Keep real values in ignored .dev.vars, never Git.
DISCORD_CLIENT_ID=''
DISCORD_CLIENT_SECRET=''
DISCORD_REDIRECT_URI='http://localhost:8787/admin/auth/callback'
DISCORD_GUILD_ID=''
DISCORD_ROLE_ID=''
# Reuse the existing key for an existing database. Generate a new key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=''
